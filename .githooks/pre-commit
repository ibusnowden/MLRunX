#!/bin/sh

# Block committing Markdown files (.md), except root README.md
staged_md=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.md$' | grep -v '^README\.md$')
if [ -n "$staged_md" ]; then
  echo "Error: committing Markdown files is disabled for this repo (except README.md)."
  echo "Unstage these files before committing:"
  echo "$staged_md"
  exit 1
fi

exit 0

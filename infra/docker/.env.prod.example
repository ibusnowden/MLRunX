# =============================================================================
# MLRunX single-domain production environment
# Copy to .env.prod and update values.
# =============================================================================

# Public domain served by Caddy
MLRUNX_DOMAIN=mlrunx.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API runtime
# -----------------------------------------------------------------------------
RUST_LOG=info,mlrunx_api=debug
MLRUNX_AUTH_DISABLED=false
MLRUNX_API_KEY=
MLRUNX_SQLITE_PATH=/data/mlrunx.db

# -----------------------------------------------------------------------------
# UI JWT session auth
# -----------------------------------------------------------------------------
MLRUNX_UI_JWT_AUTH_ENABLED=true
# Recommended with Supabase JWT signing keys: ES256 public-key verification.
# Use RS256 only if your identity provider signs with RSA.
MLRUNX_JWT_ALGORITHM=ES256
# PEM can be one line with literal \n escapes.
MLRUNX_JWT_PUBLIC_KEY_PEM=
# Leave empty for ES256/RS256. Only set for HS256 mode.
MLRUNX_JWT_SECRET=
MLRUNX_UI_COOKIE_SECURE=true
MLRUNX_UI_COOKIE_SAMESITE=Lax
MLRUNX_UI_SESSION_TTL_SECONDS=900
MLRUNX_UI_SESSION_COOKIE_NAME=mlrunx_ui_session
MLRUNX_UI_CSRF_COOKIE_NAME=mlrunx_ui_csrf

# Optional JWT claim validation
# MLRUNX_JWT_ISSUER=
# MLRUNX_JWT_AUDIENCE=

# -----------------------------------------------------------------------------
# RBAC rollout flags (canary-safe defaults)
# -----------------------------------------------------------------------------
MLRUNX_RBAC_ENDPOINT_ENFORCEMENT_ENABLED=true
MLRUNX_RBAC_READ_ENFORCEMENT_ENABLED=false
MLRUNX_RBAC_WRITE_ENFORCEMENT_ENABLED=false
MLRUNX_RBAC_ADMIN_ENFORCEMENT_ENABLED=false

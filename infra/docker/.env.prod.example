# =============================================================================
# MLRunX single-domain production environment
# Copy to .env.prod and update values.
# =============================================================================

# Public domain served by Caddy
MLRUNX_DOMAIN=mlrunx.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API runtime
# -----------------------------------------------------------------------------
RUST_LOG=info,mlrunx_api=debug
MLRUNX_AUTH_MODE=hybrid
MLRUNX_API_KEY=
MLRUNX_SQLITE_PATH=/data/mlrunx.db

# -----------------------------------------------------------------------------
# UI JWT session auth
# -----------------------------------------------------------------------------
# Set MLRUNX_AUTH_MODE=api_key and MLRUNX_UI_JWT_AUTH_ENABLED=false for API-key-only mode.
MLRUNX_UI_JWT_AUTH_ENABLED=true
# Recommended with Supabase JWT signing keys: ES256 public-key verification.
# Use RS256 only if your identity provider signs with RSA.
MLRUNX_JWT_ALGORITHM=ES256
# PEM can be one line with literal \n escapes.
MLRUNX_JWT_PUBLIC_KEY_PEM=
# Leave empty for ES256/RS256. Only set for HS256 mode.
MLRUNX_JWT_SECRET=
# Required in all environments. Used to hash session/share tokens and key fingerprints.
# Generate: openssl rand -hex 32
MLRUNX_AUTH_HMAC_SECRET=
MLRUNX_UI_COOKIE_SECURE=true
MLRUNX_UI_COOKIE_SAMESITE=Lax
# Optional. Set when UI/API are served on subdomains and cookies must be shared.
# Example: .example.com
MLRUNX_UI_COOKIE_DOMAIN=
MLRUNX_TRUST_PROXY_HEADERS=true
MLRUNX_UI_SESSION_TTL_SECONDS=900
MLRUNX_UI_SESSION_COOKIE_NAME=mlrunx_ui_session
MLRUNX_UI_CSRF_COOKIE_NAME=mlrunx_ui_csrf

# Required when MLRUNX_UI_JWT_AUTH_ENABLED=true.
MLRUNX_JWT_ISSUER=https://<supabase-project-ref>.supabase.co/auth/v1
MLRUNX_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# RBAC enforcement flags (secure defaults)
# -----------------------------------------------------------------------------
MLRUNX_RBAC_ENDPOINT_ENFORCEMENT_ENABLED=true
MLRUNX_RBAC_READ_ENFORCEMENT_ENABLED=true
MLRUNX_RBAC_WRITE_ENFORCEMENT_ENABLED=true
MLRUNX_RBAC_ADMIN_ENFORCEMENT_ENABLED=true

# =============================================================================
# MLRunX Environment Configuration
# Copy this file to .env and customize as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Privacy & Telemetry Configuration (PRIVACY-FIRST DEFAULTS)
# -----------------------------------------------------------------------------
# MLRunX is designed to be privacy-first. All data stays local by default.
# No outbound network calls are made unless explicitly enabled.

# Disable all telemetry (default: true = telemetry disabled)
MLRUNX_TELEMETRY_DISABLED=true

# Disable crash reporting (default: true = crash reporting disabled)
MLRUNX_CRASH_REPORTING_DISABLED=true

# Disable usage analytics (default: true = analytics disabled)
MLRUNX_ANALYTICS_DISABLED=true

# Disable update checks (default: true = update checks disabled)
MLRUNX_UPDATE_CHECK_DISABLED=true

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Bootstrap API key for initial setup (set this to a secure random value)
# Generate: openssl rand -hex 32
MLRUNX_API_KEY=
# Bootstrap key TTL in seconds (default: 900, max: 86400)
MLRUNX_BOOTSTRAP_KEY_TTL_SECONDS=900

# Required: secret used to hash auth/session/share tokens.
# Generate: openssl rand -hex 32
MLRUNX_AUTH_HMAC_SECRET=

# Trust X-Forwarded-For / X-Real-IP only behind a trusted reverse proxy.
MLRUNX_TRUST_PROXY_HEADERS=false
# Required when MLRUNX_TRUST_PROXY_HEADERS=true (comma-separated IP/CIDR list).
MLRUNX_TRUSTED_PROXY_CIDRS=

# Share links are disabled by default. Enable only when required.
MLRUNX_SHARE_LINKS_ENABLED=false
# Maximum allowed share-link expiry in days.
MLRUNX_SHARE_LINK_MAX_TTL_DAYS=1

# Set to "true" to disable authentication (dev mode only!)
# WARNING: Never disable auth in production
MLRUNX_AUTH_DISABLED=false
# Required override to run with MLRUNX_AUTH_MODE=disabled (local loopback only).
MLRUNX_ALLOW_INSECURE_LOCAL_DEV=false

# -----------------------------------------------------------------------------
# Data Retention Configuration (Planned)
# -----------------------------------------------------------------------------
# Note: these values are reserved for future retention enforcement.
# Metrics TTL in days (default: 90 days)
MLRUNX_METRICS_RETENTION_DAYS=90

# Artifact TTL in days (default: 365 days, 0 = never delete)
MLRUNX_ARTIFACTS_RETENTION_DAYS=365

# System logs TTL in days (default: 7 days)
MLRUNX_LOGS_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# ClickHouse Configuration (Time-series metrics storage)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=mlrunx
# REQUIRED: Set a strong password. Generate with: openssl rand -hex 32
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=mlrunx

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Metadata storage)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mlrunx
# REQUIRED: Set a strong password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DATABASE=mlrunx
# Update this URL with the password you set above
DATABASE_URL=postgres://mlrunx:CHANGE_ME@postgres:5432/mlrunx

# -----------------------------------------------------------------------------
# MinIO Configuration (Artifact storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=mlrunx
# REQUIRED: Set a strong secret key. Generate with: openssl rand -hex 32
MINIO_SECRET_KEY=
MINIO_BUCKET=mlrunx-artifacts
MINIO_PATH_STYLE=true
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRY=3600

# -----------------------------------------------------------------------------
# Redis Configuration (Caching)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# API Service Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_HTTP_PORT=3001
API_GRPC_PORT=50051
RUST_LOG=info,mlrunx_api=debug

# -----------------------------------------------------------------------------
# Ingest Mode Configuration
# -----------------------------------------------------------------------------
# direct: write directly to ClickHouse/Postgres (alpha mode)
# queued: use Redis/Kafka queue (future)
INGEST_MODE=direct

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# Disable Next.js telemetry (enforced by default)
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration (Optional - for self-hosted observability)
# -----------------------------------------------------------------------------
# Only used if you enable the observability profile:
#   docker compose --profile observability up
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mlrunx
